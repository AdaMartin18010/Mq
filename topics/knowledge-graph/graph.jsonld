    {
      "id": "mq:system-redis",
      "type": "mq:System",
      "name": "Redis",
      "source": "项目知识库",
      "note": "TEST-C2 矩阵未覆盖，未建立能力边"
    },
    {
      "id": "mq:ase-001",
      "type": "mq:Assertion",
      "name": "ASE-001",
      "definition": "交付语义/Kafka: 生产者 acks=all、min.insync.replicas=2 的三 broker 集群; 消息获 ISR 内两副本确认后其中一副本宕机; 已确认消息不丢、消费者可见重复计数<=1; 存在性断言+重复计数",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-002",
      "type": "mq:Assertion",
      "name": "ASE-002",
      "definition": "交付语义/NATS: Core（非 JetStream）subject 上生产后 broker 重启; 消费者未在线期间 broker 重启; 重启前未投递消息丢失不违反语义; 反向用例：确认不承诺",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-003",
      "type": "mq:Assertion",
      "name": "ASE-003",
      "definition": "顺序性/Kafka: 单分区 topic、并发生产者 3 个; 持续生产 1000 条; 单分区内消费顺序与生产偏移单调一致; 全序比对",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-004",
      "type": "mq:Assertion",
      "name": "ASE-004",
      "definition": "幂等去重/Kafka: 幂等生产者开启（enable.idempotence=true）; broker 故障转移触发重试; 单分区日志无重复序列号消息; broker 日志审计",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-005",
      "type": "mq:Assertion",
      "name": "ASE-005",
      "definition": "幂等去重/NATS: JetStream 开启 dedup window、Msg-Id 重复发布; 同 Msg-Id 在窗口内发布两次; 仅第一条持久化; 服务端去重计数",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-006",
      "type": "mq:Assertion",
      "name": "ASE-006",
      "definition": "重试退避/NATS: 消费者 nak 且配置 backoff 序列; 连续投递失败; 重投间隔符合 backoff 序列直至 maxDeliver; 重投时间戳序列断言",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-007",
      "type": "mq:Assertion",
      "name": "ASE-007",
      "definition": "死信/RabbitMQ: 队列绑定 DLX、消费者 nack(requeue=false); 消息处理持续异常; 消息进入 DLQ、原队列清空、DLQ 可再消费; DLQ 深度=1 且原队列=0",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-008",
      "type": "mq:Assertion",
      "name": "ASE-008",
      "definition": "死信/Pulsar: namespace 级 DLQ policy 配置、共享订阅; nack 超过 maxRedeliverCount; 消息进入 DLQ topic 且原订阅游标推进; DLQ topic 深度断言",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-009",
      "type": "mq:Assertion",
      "name": "ASE-009",
      "definition": "事务/Kafka: 事务生产者 initTransactions+send 两分区+commitOffsets; 提交后消费隔离级别 read_committed; 仅已提交消息对下游可见; read_committed 消费断言",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-010",
      "type": "mq:Assertion",
      "name": "ASE-010",
      "definition": "背压/NATS: pull consumer maxAckPending=100 且消费端不 ack; 生产端持续投递; broker 在 100 条未确认处停推新批、进程无 OOM; 未确认数平台期=100",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-011",
      "type": "mq:Assertion",
      "name": "ASE-011",
      "definition": "背压/RabbitMQ: 消费者 prefetch=50 且不 ack; 生产端持续投递; 未确认消息数停于 50、内存曲线平稳; QoS 未确认数断言",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-012",
      "type": "mq:Assertion",
      "name": "ASE-012",
      "definition": "TTL过期/MQTT: v5 消息带 message expiry interval=2s、订阅者会话过期=0; 订阅者 5 秒后重连; 过期消息不投递; 接收计数=0【定理】",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-013",
      "type": "mq:Assertion",
      "name": "ASE-013",
      "definition": "延迟消息/Pulsar: 生产者 send(msg).deliverAfter(3s); 立即查询订阅 backlog; 3 秒前不可见、3 秒后按序可见; 时间窗可见性断言",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-014",
      "type": "mq:Assertion",
      "name": "ASE-014",
      "definition": "持久化/Redis: AOF everysec+Stream key 已有 100 条; 重启 Redis 实例; Stream 长度与 ID 单调性保持; 长度=100 且 last-ID 不回落",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-015",
      "type": "mq:Assertion",
      "name": "ASE-015",
      "definition": "持久化/RabbitMQ: durable queue + persistent 消息投递; broker 重启; 消息与拓扑均存活; 重启后队列深度+消息完整性断言",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-016",
      "type": "mq:Assertion",
      "name": "ASE-016",
      "definition": "交付语义/CloudEvents: 信封含 specversion/type/source/id 四必需属性（02-57 已核实）; 任意传输绑定（HTTP/Kafka/MQTT）; 四属性缺失即拒绝解析; 信封静态断言（tc-assert-check 扩展项）",
      "source": "assertions.tsv"
    },
    {
      "id": "mq:ase-017",
      "type": "mq:Assertion",
      "name": "ASE-017",
      "definition": "流控/OTel: trace-id 消息头贯穿 producer→broker→consumer; 端到端一次业务流; 全链 span 关联不断（messaging.* 属性按 semconv）; trace 完整性断言（E2 真实执行挂账）",
      "source": "assertions.tsv"
    },
